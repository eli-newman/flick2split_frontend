# Public env vars exposed to the Expo client (gitignored .env).
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and visible to anyone.
# Never put secrets here.

# Backend (Firebase Cloud Functions base URL)
EXPO_PUBLIC_BACKEND_URL=

# RevenueCat — PUBLIC app-specific keys only (appl_... / goog_...)
# Get them at: https://app.revenuecat.com/projects/_/api-keys → "Public app-specific API keys"
# DO NOT use secret keys (sk_...) here — they ship in the bundle.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
